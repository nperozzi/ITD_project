{
  "name": "esl-project",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "root": ".",
  "targets": {
    "up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DOCKER_CONFIG=.docker docker compose up --build"
      }
    },
    "down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DOCKER_CONFIG=.docker docker compose down"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DOCKER_CONFIG=.docker docker compose build"
      }
    }
  }
}
