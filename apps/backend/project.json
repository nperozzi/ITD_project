{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/backend",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DOCKER_CONFIG=.docker docker compose build backend"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DOCKER_CONFIG=.docker docker compose up --build backend mosquitto"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m compileall apps/backend/src"
      }
    }
  }
}
