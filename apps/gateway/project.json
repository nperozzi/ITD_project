{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/gateway",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DOCKER_CONFIG=.docker docker compose build gateway"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DOCKER_CONFIG=.docker docker compose up --build gateway mosquitto"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m compileall apps/gateway"
      }
    }
  }
}
