{
  "name": "gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/gateway",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run scripts/docker-compose-runner.mjs build gateway"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run scripts/docker-compose-runner.mjs up --build gateway mosquitto"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun run scripts/python-syntax-check.mjs apps/gateway"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/gateway",
        "command": "python -m pytest"
      }
    }
  }
}
