{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/frontend",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "bun run dev"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "bun run build"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "bun run check"
      }
    }
  }
}
