{
  "name": "mosquitto",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "infra/mosquitto",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "DOCKER_CONFIG=.docker docker compose up mosquitto"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test -f infra/mosquitto/mosquitto.conf"
      }
    }
  }
}
